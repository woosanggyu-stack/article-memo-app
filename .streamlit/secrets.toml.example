# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 실제 값을 채워넣으세요.
# secrets.toml은 .gitignore에 등록되어 있어 GitHub에는 올라가지 않습니다.

sheet_id = "구글시트_URL의_/d/와_/edit_사이_긴_문자열"
drive_folder_id = "구글드라이브_폴더_URL의_마지막_문자열"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n여기에_줄바꿈을_\\n으로_유지한_채_붙여넣기\n-----END PRIVATE KEY-----\n"
client_email = "xxx@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
